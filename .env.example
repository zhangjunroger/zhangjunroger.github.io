# ============================================================
# 《自动控制原理》AI智慧课程 - 生产环境配置示例
# 复制本文件为 .env 并填入真实值
# ============================================================

# --- 服务器基础配置 ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# --- 安全与认证 ---
JWT_SECRET=please_change_me_to_a_long_random_string_at_least_32_chars!!!
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- 数据持久化 ---
DATA_DIR=./data
STORAGE_BACKEND=json     # 可选: json (默认,零配置) | sqlite (需安装 better-sqlite3)

# --- AI服务配置 (可选,接入真实LLM) ---
AI_PROVIDER=mock        # mock | openai | qwen | deepseek
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=

# --- 部署配置 ---
VITE_BASE_URL=/
VITE_API_BASE=/api

# --- 性能 ---
COMPRESS_ASSETS=true
ENABLE_CACHE=true
