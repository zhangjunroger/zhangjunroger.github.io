# 生产环境配置模板 — 复制为 .env 后使用
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# 【必改】登录令牌签名密钥，改成任意随机长字符串
JWT_SECRET=change_me_to_a_long_random_string_here_1234567890
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# 【必改】加上课页访问地址（多个用逗号分隔），如 http://服务器IP:4000 或 http://你的域名
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# 本地 SQLite 数据库目录（相对部署包根目录）
DATA_DIR=./data
STORAGE_BACKEND=sqlite

# AI 助教（默认 mock；如需真实大模型填入 API Key 与 BaseUrl）
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=

COMPRESS_ASSETS=true
ENABLE_CACHE=true
