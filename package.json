{
  "name": "zdkzyl-control-theory-course",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "《自动控制原理》AI智慧课程 - 生产级全栈系统",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch api/index.ts",
    "dev:fullstack": "concurrently -k -n WEB,API -c cyan,magenta \"npm:dev\" \"npm:dev:server\"",
    "build": "npm run check && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "cross-env NODE_ENV=production node dist-server/api/index.js",
    "seed": "tsx api/seeds/seed.ts",
    "lint": "eslint .",
    "preview": "cross-env NODE_ENV=production vite preview --host 0.0.0.0",
    "check": "tsc -b --noEmit",
    "deploy:prepare": "npm run build && npm run build:server",
    "build:static": "cross-env VITE_STATIC_MODE=1 vite build --outDir dist-ghpages --emptyOutDir",
    "pack:pages": "node scripts/pack-ghpages.mjs",
    "deploy:pages": "npm run build:static && npm run pack:pages"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.511.0",
    "nanoid": "^5.1.5",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-katex": "^3.0.1",
    "react-router-dom": "^7.3.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-katex": "^3.0.4",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-dev-locator": "^1.0.6",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "katex": "^0.16.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-compression2": "^1.3.3",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
